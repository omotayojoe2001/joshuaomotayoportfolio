# Copy to .env and fill in. Never commit real keys (.env is gitignored).
# Only the public/anon key belongs in the client. The service-role key is for
# server/runtime only (e.g. Vercel env var) and must never be committed.

SUPABASE_PROJECT_ID=""
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Server-only. Do NOT put a real value in a committed file.
# SUPABASE_SERVICE_ROLE_KEY=""
